+// `why` is the personal part: one honest sentence on why you built it.
+// Leave `link` empty to hide the button.
+
+interface Project {
+  name: string
+  year: string
+  why: string
+  description: string
+  stack: string[]
+  link?: string
+}
+
+const projects: Project[] = [
+  {
+    name: "Tally",
+    year: "[YEAR]",
+    why: "[Why you built it, in your words. e.g. “I wanted …, nothing out there did it the way I liked.”]",
